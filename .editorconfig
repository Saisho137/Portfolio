# Whitespace for every file, also the ones Prettier doesn't format (git hooks, .npmrc,
# .gitignore). Prettier reads indentation and line endings from here: single source
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
